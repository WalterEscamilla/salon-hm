# Copia este archivo a .env. Nunca compartas .env ni lo subas a Git.
# Genera una clave propia con el comando indicado en el README.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo en Railway u otro proxy HTTPS de confianza: True.
DJANGO_TRUST_PROXY=False

# Base existente. Usa el usuario y la contraseña reales de PostgreSQL.
POSTGRES_DB=salon_hm
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
# Opcional: una URL completa tiene prioridad sobre los campos POSTGRES_*.
# Déjalo vacío cuando uses los campos anteriores.
DATABASE_URL=

# Asistente. La clave se usa únicamente en el servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DAILY_REQUEST_LIMIT=60

# Google Calendar: cliente OAuth de tipo Aplicación web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/calendario/google/retorno/
# Cuenta autorizada para entrar; se vincula con una usuaria existente.
GOOGLE_LOGIN_EMAIL=
GOOGLE_LOGIN_USERNAME=Marisol
# Generar una vez; conservar junto con los respaldos, por separado de PostgreSQL.
GOOGLE_TOKEN_ENCRYPTION_KEY=
